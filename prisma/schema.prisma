generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VISITOR
  OWNER
  ADMIN
}

/// Only APPROVED businesses are ever shown publicly.
enum BusinessStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  email         String         @unique
  emailVerified Boolean        @default(false) @map("email_verified")
  name          String
  image         String?
  phone         String?
  role          Role           @default(VISITOR)
  isDemo        Boolean        @default(false) @map("is_demo")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  businesses    Business[]
  sessions      Session[]
  accounts      Account[]
  claimRequests ClaimRequest[]
  reports       Report[]
  auditLogs     AuditLog[]
  reviews       Review[]
  favorites     Favorite[]

  @@map("users")
}

/// A signed-in browser. Managed by Better Auth; the cookie holds `token`.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in. For email and password, providerId is "credential" and `password`
/// holds the Argon2id hash.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens for email verification and password resets.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Province {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String     @unique
  districts District[]

  @@map("provinces")
}

model District {
  id         Int        @id @default(autoincrement())
  slug       String     @unique
  name       String     @unique
  provinceId Int        @map("province_id")
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  businesses Business[]

  @@index([provinceId])
  @@map("districts")
}

model Category {
  id         Int                @id @default(autoincrement())
  slug       String             @unique
  name       String
  sortOrder  Int                @map("sort_order")
  businesses BusinessCategory[]

  @@map("categories")
}

model Business {
  id               String             @id @default(uuid(7)) @db.Uuid
  slug             String             @unique
  name             String
  tagline          String
  description      String
  status           BusinessStatus     @default(DRAFT)
  isFeatured       Boolean            @default(false) @map("is_featured")
  isDemo           Boolean            @default(false) @map("is_demo")
  districtId       Int                @map("district_id")
  district         District           @relation(fields: [districtId], references: [id], onDelete: Restrict)
  sector           String?
  address          String?
  latitude         Decimal?           @db.Decimal(9, 6)
  longitude        Decimal?           @db.Decimal(9, 6)
  phone            String?
  whatsapp         String?
  email            String?
  website          String?
  facebookUrl      String?            @map("facebook_url")
  instagramUrl     String?            @map("instagram_url")
  /// 1 = budget, 2 = mid-range, 3 = upscale
  priceLevel       Int?               @map("price_level") @db.SmallInt
  ownerId          String?            @map("owner_id") @db.Uuid
  owner            User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// When the owner last sent the listing for review.
  submittedAt      DateTime?          @map("submitted_at")
  /// What an admin asked the owner to change; shown while the listing needs changes.
  reviewNote       String?            @map("review_note")
  /// Average of published reviews (0 when there are none) and how many there are. Kept up to
  /// date whenever a review changes, so cards and sorting don't have to count every time.
  ratingAverage    Float              @default(0) @map("rating_average")
  ratingCount      Int                @default(0) @map("rating_count")
  /// When an admin last approved, rejected or suspended the listing.
  reviewedAt       DateTime?          @map("reviewed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  categories       BusinessCategory[]
  openingHours     OpeningHours[]
  photos           Photo[]
  showcaseSections ShowcaseSection[]
  claimRequests    ClaimRequest[]
  reports          Report[]
  reviews          Review[]
  favorites        Favorite[]
  dailyStats       DailyStat[]

  @@index([status, districtId])
  @@index([ownerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "businesses_name_trgm_idx")
  @@map("businesses")
}

model BusinessCategory {
  businessId String   @map("business_id") @db.Uuid
  categoryId Int      @map("category_id")
  /// 0 is the business's main category, shown on its card.
  position   Int      @db.SmallInt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([businessId, categoryId])
  @@unique([businessId, position])
  @@index([categoryId])
  @@map("business_categories")
}

/// One row per opening period; a day with no rows is a closed day. Times are minutes after
/// midnight in Africa/Kigali. A period that runs past midnight has closesAt <= opensAt.
model OpeningHours {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// ISO weekday: 1 = Monday … 7 = Sunday
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  opensAt    Int      @map("opens_at") @db.SmallInt
  closesAt   Int      @map("closes_at") @db.SmallInt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
  @@map("opening_hours")
}

/// Stored as WebP files in three sizes: `<storageKey>-sm.webp`, `-md.webp` and `-lg.webp`.
/// Position 0 is the cover photo.
model Photo {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  storageKey  String   @map("storage_key")
  /// Size of the largest stored version.
  width       Int
  height      Int
  /// A tiny blurred copy shown while the photo loads.
  blurDataUrl String   @default("") @map("blur_data_url")
  altText     String   @map("alt_text")
  position    Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, position])
  @@map("photos")
}

/// A group on the profile page, e.g. "Mains" on a menu or "Rooms" at a guesthouse.
model ShowcaseSection {
  id         String         @id @default(uuid(7)) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  title      String
  position   Int            @db.SmallInt
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      ShowcaseItem[]

  @@index([businessId, position])
  @@map("showcase_sections")
}

model ShowcaseItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  sectionId   String          @map("section_id") @db.Uuid
  name        String
  description String?
  priceRwf    Int?            @map("price_rwf")
  position    Int             @db.SmallInt
  section     ShowcaseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@map("showcase_items")
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Someone asking to manage an existing listing that has no owner. An admin checks it.
model ClaimRequest {
  id           String      @id @default(uuid(7)) @db.Uuid
  businessId   String      @map("business_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  /// How they're connected to the business, e.g. "Owner" or "Manager".
  relationship String
  /// A number the admin can call to check the claim.
  contactPhone String      @map("contact_phone")
  message      String
  /// Private file (photo or PDF) proving the connection; never served publicly.
  evidenceKey  String?     @map("evidence_key")
  evidenceType String?     @map("evidence_type")
  status       ClaimStatus @default(PENDING)
  decisionNote String?     @map("decision_note")
  decidedAt    DateTime?   @map("decided_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([businessId])
  @@index([userId])
  @@map("claim_requests")
}

enum ReportReason {
  CLOSED
  WRONG_INFO
  NOT_REAL
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A visitor telling the admins something is wrong with a listing.
model Report {
  id             String       @id @default(uuid(7)) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  reporterId     String?      @map("reporter_id") @db.Uuid
  reason         ReportReason
  message        String
  status         ReportStatus @default(OPEN)
  resolutionNote String?      @map("resolution_note")
  resolvedAt     DateTime?    @map("resolved_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reporter       User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessId])
  @@index([reporterId])
  @@map("reports")
}

/// Every admin action, written in the same transaction as the change itself.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// e.g. "listing.approve"; see src/lib/audit.ts
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  /// A readable sentence, kept even if the target is later deleted.
  summary    String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// One review per person per business. Published straight away; admins can hide it.
model Review {
  id             String       @id @default(uuid(7)) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  /// 1 to 5 stars
  rating         Int          @db.SmallInt
  comment        String
  status         ReviewStatus @default(PUBLISHED)
  /// Why an admin hid it; only admins see this.
  hiddenReason   String?      @map("hidden_reason")
  ownerReply     String?      @map("owner_reply")
  ownerRepliedAt DateTime?    @map("owner_replied_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([businessId, authorId])
  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
  @@map("reviews")
}

/// A business someone saved to find again.
model Favorite {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("favorites")
}

/// Visits and contact taps per business per day (Kigali time). Only totals are kept: no IP
/// addresses, cookies or anything else that could identify a visitor.
model DailyStat {
  businessId     String   @map("business_id") @db.Uuid
  day            DateTime @db.Date
  views          Int      @default(0)
  whatsappClicks Int      @default(0) @map("whatsapp_clicks")
  callClicks     Int      @default(0) @map("call_clicks")
  emailClicks    Int      @default(0) @map("email_clicks")
  websiteClicks  Int      @default(0) @map("website_clicks")
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day])
  @@map("daily_stats")
}
