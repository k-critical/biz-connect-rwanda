# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection. `npm run db:setup` writes this line into .env for you.
DATABASE_URL=postgresql://bizconnect:CHANGE_ME@localhost:5432/bizconnect

# Signs login cookies and email links. 32+ random characters; `npm run db:setup` fills it in.
# Generate one yourself with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Mailpit, the local test inbox. These match a fresh Mailpit install.
# In production, use your email provider's SMTP settings (SMTP_SECURE=true for port 465).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=BizConnect Rwanda <no-reply@bizconnect.local>

# Public address of the site, used in links and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, seed only: give demo listings YOUR OWN WhatsApp number to test contact buttons.
# Left empty, demo listings have no number, so no stranger ever gets messaged.
# SEED_DEMO_WHATSAPP=+2507XXXXXXXX
