# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection. `npm run db:setup` writes this line into .env for you.
DATABASE_URL=postgresql://bizconnect:CHANGE_ME@localhost:5432/bizconnect

# Mailpit, the local test inbox. These match a fresh Mailpit install.
SMTP_HOST=localhost
SMTP_PORT=1025

# Public address of the site, used in links and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
